{
  "name": "sna.js",
  "version": "0.0.0",
  "description": "A TypeScript/JavaScript port template for the R sna social network analysis package.",
  "type": "module",
  "sideEffects": false,
  "license": "GPL-2.0-or-later",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "inventory": "node scripts/create-function-inventory.mjs",
    "r:parity": "Rscript scripts/generate-r-snapshots.R",
    "example:node": "npm run build && node examples/node.mjs"
  },
  "keywords": [
    "sna",
    "social-network-analysis",
    "graph",
    "network-analysis",
    "typescript",
    "javascript"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
