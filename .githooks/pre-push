#!/bin/sh
# Gate every pushed ref for prohibited paths and high-confidence secret shapes.
# Gate pushes of main additionally with tsc --noEmit + next build.
#
# Why: the vitest suite never type-checks and no test imports /workspace/ena,
# so a green `npm test` does not prove main builds — it shipped a non-building
# main twice (see .github/workflows/build-gate.yml). CI runs the same gate on
# the pushed ref; this hook catches it before the push leaves this machine,
# which matters here because two agents share this clone.
#
# Scope: the fast security check applies to every branch and inspects each
# outgoing commit, including a forbidden file added and later removed. The
# multi-minute type-check/build remains scoped to refs/heads/main.
#
# Limitation: this builds the WORKING TREE, not the pushed ref. Pushing main
# while the tree has another branch checked out can pass on the wrong content;
# CI on the ref is the authority. Bypass (emergencies only): git push --no-verify

target_root=$(git rev-parse --show-toplevel) || exit 1
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
source_root=$(dirname -- "$hook_dir")
remote_name=${1-}
remote_location=${2-}
[ -n "$remote_name" ] && [ -n "$remote_location" ] || {
  echo "pre-push: Git did not provide both remote name and location; push refused." >&2
  exit 1
}
updates_file=$(mktemp "${TMPDIR:-/tmp}/sena-pre-push-updates.XXXXXX") || exit 1
trap 'rm -f "$updates_file"' EXIT HUP INT TERM

gating=0
update_count=0
outgoing_sha=
while read -r local_ref local_sha remote_ref remote_sha; do
  printf '%s %s %s %s\n' "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" >> "$updates_file" || {
    echo "pre-push: failed to preserve the complete outgoing update list; push refused." >&2
    exit 1
  }
  update_count=$((update_count + 1))
  outgoing_sha=$local_sha
  case "$remote_ref" in
    refs/heads/main) gating=1 ;;
  esac
done

[ "$update_count" -eq 1 ] || {
  echo "pre-push: exactly one current-branch ref update is required; push refused." >&2
  exit 1
}

echo "pre-push: validating the outgoing registry snapshot and canonical remote before external contact" >&2
if ! env SENA_GOVERNANCE_TARGET_ROOT="$target_root" SENA_GOVERNANCE_REMOTE_LOCATION="$remote_location" \
  node "$source_root/scripts/verify-sena-repo-governance.mjs" push-policy --remote-name "$remote_name" < "$updates_file"; then
  echo "pre-push: outgoing ref ownership policy failed; push refused." >&2
  exit 1
fi

echo "pre-push: validating registered topology, preservation custody, and live remote state" >&2
if ! env SENA_GOVERNANCE_TARGET_ROOT="$target_root" \
  node "$source_root/scripts/verify-sena-repo-governance.mjs" audit --pre-push --live --registry-from-commit "$outgoing_sha" >/dev/null; then
  echo "pre-push: repository governance audit failed; push refused." >&2
  exit 1
fi

echo "pre-push: scanning every outgoing ref for prohibited paths and redacted secret rules" >&2
if ! env SENA_GOVERNANCE_TARGET_ROOT="$target_root" \
  node "$source_root/scripts/verify-sena-repo-governance.mjs" security --pre-push --remote-name "$remote_name" < "$updates_file"; then
  echo "pre-push: repository security gate failed; push refused without printing secret values." >&2
  exit 1
fi

[ "$gating" -eq 1 ] || exit 0

echo "pre-push: gating main with tsc --noEmit + next build (bypass: --no-verify)" >&2
cd "$target_root/sena-hk-template" || exit 1

if ! npx tsc --noEmit; then
  echo "pre-push: tsc --noEmit failed — push of main refused." >&2
  exit 1
fi

if ! npm run build; then
  echo "pre-push: next build failed — push of main refused." >&2
  exit 1
fi

echo "pre-push: gate passed." >&2
exit 0
